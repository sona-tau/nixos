(defpoll active-wss
    :interval 15
    `swaymsg -t get_workspaces -r`)

(defwidget workspaces []
    (eventbox
        (box
        :class "workspaces"
        :orientation "h"
        :space-evenly false
        :hexpand true
        (for ws in active-wss
            (button :class "workspace ${ ws.focused ? "focused" : "" }"
                :onclick "swaymsg workspace ${ws.name}" " ")))))

(defwidget img [path]
    (box :class "image"
        (image :path path :preserve-aspect-ratio true)))

(defwidget bar []
    (box :orientation "h" :space-evenly false :halign "center"
        (workspaces)))

(defwindow bar
     :monitor 0
     :geometry (geometry
         :x "0%"
         :y "0px"
         :height "15px"
         :anchor "top center")
     :stacking "bottom"
     :exclusive true
     (bar))

(defwidget clock []
    (label :class "clock" :text "TIME :: ${formattime(EWW_TIME, "%H:%M")}")
)

(defwindow clock
    :monitor 0
    :geometry (geometry
        :x "80%"
        :y "-30px"
        :height "15px"
        :anchor "top left")
    :stacking "bottom"
    :exclusive true
    (clock))

(defwidget battery []
    ; (progress :class "battery" :orientation "h" :value {EWW_BATTERY.BAT1.capacity / 100}))
    (label :class "batery" :text "BAT :: ${EWW_BATTERY.BAT1.capacity / 100}%"))

(defwindow battery
    :monitor 0
    :geometry (geometry
        :x "80%"
        :y "-30px"
        :height "15px"
        :anchor "top right")
    :stacking "bottom"
    :exclusive true
    (battery))
